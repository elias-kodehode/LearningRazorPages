@page
@model LearningRazerPages.Pages.PeopleModel

<h2>People</h2>


@if(TempData["Success"] is string message)
{
	<div class="alert alert-success">
		@message
	</div>
}



<form method="get" asp-page="/People" class="mb-4">
	<div class="row g-3">
		<div class="col-md-6">
			<label asp-for="Search" class="form-label">
				Search by name
			</label>

			<input asp-for="Search"
				   class="form-control"
				   placeholder="Search people..." />
		</div>

		<div class="col-md-3">
			<label asp-for="MinAge" class="form-label">
				Minimum age
			</label>

			<input asp-for="MinAge"
				   class="form-control" />
		</div>

		<div class="col-md-3">
			<label asp-for="MaxAge" class="form-label">
				Maximum age
			</label>

			<input asp-for="MaxAge"
				   class="form-control" />
		</div>
	</div>

	<div class="mt-3 d-flex gap-2">
		<button type="submit" class="btn btn-primary">
			Search
		</button>

		<a asp-page="/People" class="btn btn-secondary">
			Clear
		</a>
	</div>
</form>

<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>First Name</th>
			<th>Last Name</th>
			<th>Age</th>
			<th></th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach(var p in this.Model.People)
		{
			<tr>
				<td>@p.Id</td>
				<td>@p.FirstName</td>
				<td>@p.LastName</td>
				<td>@p.Age</td>
				<td>
					<a asp-page="/people/edit" asp-route-id="@p.Id" class="btn btn-primary">Edit</a>
				</td>
				<td>
					<form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" onsubmit="return confirm('Are you sure you want to delete this person?');"> 

						<button type="submit" class="btn btn-danger">Delete</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>



<div class="d-flex justify-content-between
	align-items-center mt-3">

	<span class="text-muted">
		@Model.TotalCount people found
	</span>

	<div class="d-flex gap-2 align-items-center">

		@if(Model.PageNumber > 1)
		{
			<a asp-page="/People"
			   asp-route-Search="@Model.Search"
			   asp-route-MinAge="@Model.MinAge"
			   asp-route-MaxAge="@Model.MaxAge"
			   asp-route-PageNumber="@(Model.PageNumber - 1)"
			   class="btn btn-outline-primary">
				Previous
			</a>
		}

		<span>
			Page @Model.PageNumber of @Model.TotalPages
		</span>

		@if(Model.PageNumber < Model.TotalPages)
		{
			<a asp-page="/People"
			   asp-route-Search="@Model.Search"
			   asp-route-MinAge="@Model.MinAge"
			   asp-route-MaxAge="@Model.MaxAge"
			   asp-route-PageNumber="@(Model.PageNumber + 1)"
			   class="btn btn-outline-primary">
				Next
			</a>
		}

	</div>
</div>



<h3 style="margin: 5px;">Add Person</h3>
<form method="post">
	<div asp-validation-summary="All" class="text-danger"></div>
	<div>
		<label asp-for="NewPerson.FirstName"></label>
		<input asp-for="NewPerson.FirstName" class="form-control"/>
		<span asp-validation-for="NewPerson.FirstName" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="NewPerson.LastName"></label>
		<input asp-for="NewPerson.LastName" class="form-control" />
		<span asp-validation-for="NewPerson.LastName" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="NewPerson.Age"></label>
		<input asp-for="NewPerson.Age" class="form-control" />
		<span asp-validation-for="NewPerson.Age" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-primary" style="margin-top: 5px;">Add Person</button>
</form>